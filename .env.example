# ==============================================================================
# AI Meeting Intelligence / Meeting Follow-up Agent — Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=production

# Security & Authentication
SECRET_KEY=your-production-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Production PostgreSQL URL: postgresql+psycopg://user:password@localhost:5432/meeting_db
# Development SQLite fallback: sqlite:///../data/meeting.db
DATABASE_URL=postgresql+psycopg://meeting_user:meeting_password@postgres:5432/meeting_db

# Frontend & Backend Base URLs
FRONTEND_URL=https://meeting-ai.example.com
BACKEND_URL=https://api.meeting-ai.example.com

# CORS Configuration (Comma-separated list of allowed origins, NO wildcard '*' in production)
CORS_ORIGINS=https://meeting-ai.example.com,https://api.meeting-ai.example.com

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=500
STORAGE_PROVIDER=local

# S3 Compatible Storage (Required if STORAGE_PROVIDER=s3)
S3_BUCKET_NAME=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# FFmpeg Executable Path (Leave empty if available on system PATH)
FFMPEG_PATH=

# AI & LLM Provider Credentials
AI_PROVIDER=gemini
AI_API_KEY=your-ai-provider-api-key

# Google Calendar Integration Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://api.meeting-ai.example.com/api/v1/calendar/callback

# Gmail Integration Credentials
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret

# Redis / Task Queue Configuration
REDIS_URL=redis://redis:6379/0
